{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "America/Chicago",
  "schedule": ["before 7am"],
  "enabledManagers": ["pip_requirements", "maven"],
  "labels": ["lightwell-patch", "automated"],
  "prConcurrentLimit": 5,
  "additionalBranchPrefix": "{{parentDir}}-",
  "packageRules": [
    {
      "matchManagers": ["pip_requirements"],
      "enabled": false
    },
    {
      "matchManagers": ["pip_requirements"],
      "matchFileNames": ["apps/python/**"],
      "matchDatasources": ["pypi"],
      "matchPackageNames": ["PyYAML", "Jinja2", "Flask"],
      "enabled": true,
      "registryUrls": [
        "https://packages.redhat.com/lightwell/python/remediated/simple",
        "https://pypi.org/simple/"
      ],
      "groupName": "Lightwell remediated patches",
      "commitMessagePrefix": "fix(deps):",
      "commitMessageAction": "apply Lightwell remediated patch to",
      "commitMessageExtra": "{{currentVersion}} -> {{newVersion}}",
      "reviewers": ["zjleblanc"]
    },
    {
      "matchManagers": ["maven"],
      "enabled": false
    },
    {
      "description": "Enable once apps/java/ exists and its Lightwell-remediated package names are known -- mirror the pip_requirements rule above.",
      "matchManagers": ["maven"],
      "matchFileNames": ["apps/java/**"],
      "enabled": false,
      "registryUrls": [
        "https://packages.redhat.com/lightwell/java/remediated/simple",
        "https://repo.maven.apache.org/maven2/"
      ],
      "groupName": "Lightwell remediated patches",
      "commitMessagePrefix": "fix(deps):",
      "commitMessageAction": "apply Lightwell remediated patch to",
      "commitMessageExtra": "{{currentVersion}} -> {{newVersion}}",
      "reviewers": ["zjleblanc"]
    }
  ],
  "hostRules": [
    {
      "matchHost": "packages.redhat.com",
      "username": "{{ secrets.LIGHTWELL_USERNAME }}",
      "password": "{{ secrets.LIGHTWELL_TOKEN }}"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "lightwell-patch"]
  },
  "bumpVersions": [
    {
      "name": "Bump python app version on dependency update",
      "filePatterns": ["apps/python/config/app_config.yaml"],
      "matchStrings": ["version:\\s*\"(?<version>\\d+\\.\\d+\\.\\d+)\""],
      "bumpType": "patch"
    }
  ]
}
