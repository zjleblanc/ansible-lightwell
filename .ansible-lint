---
profile: production

exclude_paths:
  - .git/
  - .github/
  - apps/
  # Ignore third-party collections installed by galaxy.
  # Our own demo.lightwell collection is linted normally.
  - collections/ansible_collections/containers/
  - collections/ansible_collections/community/
  - collections/ansible_collections/ansible/
  # eda/ uses rulebook syntax not understood by ansible-lint.
  - eda/

use_default_rules: true

# skip no-role-prefix: roles share a common variable namespace for pipeline state flow.
skip_list:
  - var-naming[no-role-prefix]

warn_list:
  - experimental
